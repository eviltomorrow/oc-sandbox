#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SRC="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SRC")" && pwd)"
COMPOSE_DIR="$(dirname "$SCRIPT_DIR")"
COMPOSE_FILE="$COMPOSE_DIR/compose.yaml"

usage() {
  cat <<'EOF'
ocbox — run opencode in an isolated Docker sandbox

Usage:
  oc up <project-dir> [opencode args...]   Start the interactive opencode TUI
  oc run <project-dir> "prompt..."         Run opencode non-interactively
  oc install <tool> [version]              Install a toolchain into the sandbox
  oc shell <project-dir> [cmd...]          Open a bash shell inside the sandbox
  oc doctor <project-dir>                  Self-check docker/image/compose/git
  oc init <project-dir>                    Seed an opencode.json permission template
  oc config <project-dir>                  Print the effective compose config
  oc env <project-dir>                     Show resolved env/mounts for this run
  oc prune [-y]                            Remove legacy ocbox-labeled volumes (old scheme)
  oc help                                  Show this help

Env overrides:
  OC_PROJECT           default project dir when no <project-dir> given
  OC_USE_HOST_CONFIG=1   reuse host ~/.config/opencode + ~/.local/share/opencode
                         (never run host opencode on the same data concurrently)
  OC_ROOT_RW=1           writable container root fs (e.g. apt install inside)
  OC_PROJECT_RO=1        mount the project read-only (review mode)
  OC_GIT=1               mount host ~/.ssh + ~/.git-credentials for git push
  OC_CA_MOUNT=1          mount host CA bundle (internal/self-signed CA)
  OC_GIT_NAME            git commit identity (falls back to host git config)
  OC_GIT_EMAIL           git commit identity (falls back to host git config)
  OC_VERSION             opencode version to build (default: latest)
  OC_MEM_LIMIT           container memory limit (default: 4g)
  OC_PIDS_LIMIT          container pids limit (default: 256)
  INSTALL_PROXY          proxy for oc install / docker build (e.g. http://192.168.16.140:1081)

Toolchains (oc install <tool> [version]):
  rust, go, node (lts|ver), python (ver), bun
  Installed to /home/dev (oc-home volume) — survives container restarts.
EOF
}

resolve_project() {
  local dir="${1:?usage: provide a project directory}"
  if [[ "$dir" != /* ]]; then
    dir="$(pwd)/$dir"
  fi
  mkdir -p "$dir"
  dir="$(cd "$dir" && pwd)"
  printf '%s' "$dir"
}

setup_env() {
  local dir="$1"
  export WORKSPACE_DIR="$dir"

  local base hash
  base="$(basename "$dir")"
  hash="$(printf '%s' "$dir" | md5sum | cut -c1-6)"
  export OC_PROJECT_NAME="${base}-${hash}"

  # compose 的 project 名：compose 要求小写、仅 [a-z0-9_-] 且不以 -/_ 开头
  # （compose-go loader.NormalizeProjectName），这里照抄其规范化逻辑。
  # 卷名仍用未规范化的 OC_PROJECT_NAME（保持与旧卷一致，现有数据卷照常复用）。
  export OC_PROJECT_SLUG="$(printf '%s' "$OC_PROJECT_NAME" | LC_ALL=C tr 'A-Z' 'a-z' | tr -c 'a-z0-9_-' '\n' | tr -d '\n' | sed 's/^[-_]*//')"

  export OC_UID="${OC_UID:-$(id -u)}"
  export OC_GID="${OC_GID:-$(id -g)}"

  local home="${HOME:-}"
  export GITCONFIG_HOST="${GITCONFIG_HOST:-$home/.gitconfig}"
  export SSH_DIR_HOST="${SSH_DIR_HOST:-$home/.ssh}"
  export GIT_CREDENTIALS_HOST="${GIT_CREDENTIALS_HOST:-$home/.git-credentials}"
  export OPENCODE_CONFIG_HOST="${OPENCODE_CONFIG_HOST:-$home/.config/opencode}"
  export OPENCODE_DATA_HOST="${OPENCODE_DATA_HOST:-$home/.local/share/opencode}"
  export CA_BUNDLE_HOST="${CA_BUNDLE_HOST:-/etc/ssl/certs/ca-certificates.crt}"

  if [[ "${OC_PROJECT_RO:-0}" == "1" ]]; then
    export OC_PROJECT_MODE=ro
  else
    export OC_PROJECT_MODE=rw
  fi
}

build_compose_args() {
  COMPOSE_ARGS=(-f "$COMPOSE_FILE" --project-name "$OC_PROJECT_SLUG")
  if [[ "${OC_USE_HOST_CONFIG:-0}" == "1" ]]; then COMPOSE_ARGS+=(-f "$COMPOSE_DIR/compose.host.yaml"); fi
  if [[ "${OC_ROOT_RW:-0}" == "1" ]]; then COMPOSE_ARGS+=(-f "$COMPOSE_DIR/compose.rw.yaml"); fi
  if [[ "${OC_GIT:-0}" == "1" ]]; then COMPOSE_ARGS+=(-f "$COMPOSE_DIR/compose.git.yaml"); fi
  if [[ "${OC_CA_MOUNT:-0}" == "1" ]]; then COMPOSE_ARGS+=(-f "$COMPOSE_DIR/compose.ca.yaml"); fi
}

docker_compose() {
  docker compose "${COMPOSE_ARGS[@]}" "$@"
}

# 同一项目的 oc-home 卷是共享数据（opencode.db / git 锁），禁止并发。
# 用宿主侧的 flock 以项目卷名为 key 上锁；锁随脚本退出自动释放。
LOCK_DIR="${LOCK_DIR:-/tmp/ocbox-locks}"

acquire_lock() {
  local key="${1:?project volume key required}"
  mkdir -p "$LOCK_DIR"
  exec {LOCK_FD}>"$LOCK_DIR/$key.lock"
  if ! flock -n "$LOCK_FD"; then
    echo "ocbox: project '$key' is already in use by another oc session" >&2
    echo "ocbox: one sandbox per project (shared oc-home volume) — wait or use a different dir" >&2
    exit 1
  fi
}

git_identity() {
  local name email
  name="${OC_GIT_NAME:-}"
  email="${OC_GIT_EMAIL:-}"
  if [[ -z "$name" ]]; then name="$(git config --global user.name 2>/dev/null || true)"; fi
  if [[ -z "$email" ]]; then email="$(git config --global user.email 2>/dev/null || true)"; fi
  if [[ -z "$name$email" ]]; then
    echo "ocbox: warning: no git identity found (host git config has none)." >&2
    echo "ocbox: set OC_GIT_NAME and OC_GIT_EMAIL before committing." >&2
    return
  fi
  if [[ -n "$name" ]]; then export OC_GIT_NAME="$name"; fi
  if [[ -n "$email" ]]; then export OC_GIT_EMAIL="$email"; fi
}

git_env() {
  GIT_ENV=()
  if [[ -n "${OC_GIT_NAME:-}" ]]; then GIT_ENV+=(-e "GIT_AUTHOR_NAME=$OC_GIT_NAME" -e "GIT_COMMITTER_NAME=$OC_GIT_NAME"); fi
  if [[ -n "${OC_GIT_EMAIL:-}" ]]; then GIT_ENV+=(-e "GIT_AUTHOR_EMAIL=$OC_GIT_EMAIL" -e "GIT_COMMITTER_EMAIL=$OC_GIT_EMAIL"); fi
}

# 数据卷由 ocbox 自己管理（compose 里声明为 external），compose 不做生命周期；
# 每次 run 前确保存在，避免 "external volume not found"。
ensure_volumes() {
  local v
  for v in oc-home oc-tmp; do
    if ! docker volume inspect "$v-$OC_PROJECT_NAME" >/dev/null 2>&1; then
      docker volume create "$v-$OC_PROJECT_NAME" >/dev/null
    fi
  done
}

cmd_up() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  shift 2>/dev/null || true
  setup_env "$dir"
  acquire_lock "$OC_PROJECT_NAME"
  ensure_volumes
  git_identity
  build_compose_args
  git_env
  docker_compose run --rm "${GIT_ENV[@]}" oc opencode "$@"
}

cmd_run() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  shift 2>/dev/null || true
  setup_env "$dir"
  acquire_lock "$OC_PROJECT_NAME"
  ensure_volumes
  git_identity
  build_compose_args
  git_env
  docker_compose run --rm -T "${GIT_ENV[@]}" oc opencode run "$@"
}

cmd_init() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  local target="$dir/opencode.json"
  if [[ -e "$target" ]]; then
    echo "ocbox: $target already exists, skipping" >&2
  else
    cp "$COMPOSE_DIR/opencode.json.example" "$target"
    echo "ocbox: created $target"
  fi
}

cmd_shell() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  shift 2>/dev/null || true
  setup_env "$dir"
  ensure_volumes
  git_identity
  build_compose_args
  git_env
  docker_compose run --rm "${GIT_ENV[@]}" oc bash "$@"
}

cmd_config() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  shift 2>/dev/null || true
  setup_env "$dir"
  build_compose_args
  docker_compose config "$@"
}

cmd_env() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  setup_env "$dir"
  build_compose_args
  git_identity
  git_env
  printf 'WORKSPACE_DIR=%s\n' "$WORKSPACE_DIR"
  printf 'OC_PROJECT_NAME=%s\n' "$OC_PROJECT_NAME"
  printf 'compose project : %s\n' "$OC_PROJECT_SLUG"
  printf 'OC_PROJECT_MODE=%s\n' "$OC_PROJECT_MODE"
  printf 'OC_UID=%s OC_GID=%s\n' "$OC_UID" "$OC_GID"
  printf 'git identity: name=%s email=%s\n' "${OC_GIT_NAME:-<none>}" "${OC_GIT_EMAIL:-<none>}"
  printf 'compose files: %s\n' "${COMPOSE_ARGS[*]}"
  printf 'git env flags: %s\n' "${GIT_ENV[*]:-<none>}"
}

cmd_doctor() {
  local dir
  dir="$(resolve_project "${1:-${OC_PROJECT:-.}}")"
  setup_env "$dir"
  git_identity
  build_compose_args
  git_env

  local rc=0

  echo "ocbox doctor — project: $dir"
  echo "  data volume : oc-home-$OC_PROJECT_NAME"
  echo "  compose prj : $OC_PROJECT_SLUG (per-project compose project)"
  echo "  compose     : ${COMPOSE_ARGS[*]}"

  if command -v docker >/dev/null 2>&1; then
    echo "  docker cli  : $(docker --version 2>/dev/null | head -1)"
  else
    echo "  docker cli  : MISSING (not in PATH)"
    rc=1
  fi
  if docker info >/dev/null 2>&1; then
    echo "  docker dmon : reachable"
  else
    echo "  docker dmon : NOT reachable — is docker running?"
    rc=1
  fi
  if docker image inspect ocbox:latest >/dev/null 2>&1; then
    echo "  image       : ocbox:latest present"
  else
    echo "  image       : ocbox:latest MISSING — run: just build"
    rc=1
  fi
  if docker_compose config --quiet 2>/dev/null; then
    echo "  compose cfg : valid"
  else
    echo "  compose cfg : INVALID"
    rc=1
  fi

  if [[ -n "${OC_GIT_NAME:-}" && -n "${OC_GIT_EMAIL:-}" ]]; then
    echo "  git identity: ${OC_GIT_NAME} <${OC_GIT_EMAIL}>"
  else
    echo "  git identity: MISSING — set OC_GIT_NAME / OC_GIT_EMAIL"
    rc=1
  fi

  echo "  project dir : $dir ($([ -r "$dir" ] && echo readable || echo NOT readable))"

  if [[ "$rc" -eq 0 ]]; then
    echo "  all checks passed"
  fi
  return "$rc"
}

cmd_install() {
  local tool="${1:-}"
  if [[ -z "$tool" ]]; then
    echo "usage: oc install <tool> [version]" >&2
    echo "available: $(list_tools)" >&2
    exit 1
  fi
  shift 2>/dev/null || true
  if [[ ! -f "$COMPOSE_DIR/toolchains/$tool.sh" ]]; then
    echo "ocbox: unknown tool '$tool'" >&2
    echo "ocbox: available: $(list_tools)" >&2
    exit 1
  fi
  setup_env "${OC_PROJECT:-$(pwd)}"
  acquire_lock "$OC_PROJECT_NAME"
  ensure_volumes
  build_compose_args
  local proxy_env=()
  if [[ -n "${INSTALL_PROXY:-}" ]]; then
    proxy_env+=(
      -e "http_proxy=$INSTALL_PROXY"
      -e "https_proxy=$INSTALL_PROXY"
      -e "all_proxy=$INSTALL_PROXY"
      -e "no_proxy=localhost,127.0.0.1,::1"
    )
  fi
  # TTY 下用 -t：Ctrl+C 才会把 SIGINT 转发进容器停掉安装；
  # 非交互环境（管道/CI）退回 -T，避免 "the input device is not a TTY"。
  local tty=(-T)
  if [[ -t 0 ]]; then tty=(-t); fi
  docker_compose run --rm "${tty[@]}" "${proxy_env[@]}" oc bash "/opt/toolchains/$tool.sh" "$@"
}

list_tools() {
  ls "$COMPOSE_DIR"/toolchains/*.sh 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.sh$//' | grep -v entrypoint | tr '\n' ' '
}

# 旧 scheme（project 名固定 ocbox）下的 oc-home/oc-tmp 卷对 compose 已完全隐身，
# 只占磁盘。删掉它们（当前项目自己的卷除外）。
cmd_prune() {
  local force=0
  if [[ "${1:-}" == "-y" || "${1:-}" == "-f" ]]; then force=1; fi

  setup_env "${OC_PROJECT:-$(pwd)}"

  local candidates
  candidates="$({
    docker volume ls -q --filter 'label=com.docker.compose.project=ocbox' --filter 'label=com.docker.compose.volume=oc-home' 2>/dev/null
    docker volume ls -q --filter 'label=com.docker.compose.project=ocbox' --filter 'label=com.docker.compose.volume=oc-tmp' 2>/dev/null
  } | sort -u | grep -vx -e "oc-home-$OC_PROJECT_NAME" -e "oc-tmp-$OC_PROJECT_NAME" || true)"

  if [[ -z "$candidates" ]]; then
    echo "ocbox: nothing to prune (no legacy ocbox-labeled volumes)" >&2
    return
  fi

  echo "ocbox: legacy volumes to remove:"
  printf '  %s\n' $candidates

  if [[ "$force" -ne 1 ]]; then
    if [[ -t 0 ]]; then
      printf 'Remove them? [y/N] ' >&2
      local ans
      read -r ans
      [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "ocbox: aborted" >&2; return; }
    else
      echo "ocbox: non-interactive — rerun with: oc prune -y" >&2
      return 1
    fi
  fi

  # shellcheck disable=SC2086
  docker volume rm $candidates
}

cmd="${1:-help}"
case "$cmd" in
  up) shift; cmd_up "$@" ;;
  run) shift; cmd_run "$@" ;;
  install) shift; cmd_install "$@" ;;
  shell) shift; cmd_shell "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  init) shift; cmd_init "$@" ;;
  config) shift; cmd_config "$@" ;;
  env) shift; cmd_env "$@" ;;
  prune) shift; cmd_prune "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
